# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://colladoc:colladoc@localhost:5433/colladoc"

# Port the backend Express API listens on
PORT=3000

# Key encrypting TOTP secrets at rest (AES-256-GCM): 32 random bytes, base64.
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY="replace-with-a-generated-key"
