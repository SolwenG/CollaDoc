# ================================ /auth/mfa =================================
# Replayable on a database that is not purged: each run registers a fresh user ({{$timestamp}})
# and turns MFA on for it, the users of previous runs are left as they are.
# - Send the requests in order, from the top: "{{register.response...}}" only resolves once
#   the "register" request was sent in this VS Code session.
# - REST Client keeps cookies in one jar shared by every .http file: this file logs in on its own.
# - Run against the backend container (npm run dev): development sets COOKIE_SECURE=false,
#   so REST Client gets the session cookie over http.
# - Test users pile up in the dev database; clean them up with any SQL client when needed
#   (psql: docker compose exec db psql -U colladoc colladoc, or DBeaver and the like):
#   DELETE FROM "User" WHERE "username" ~ '^mfa_[0-9]+$';

@baseUrl = http://localhost:3000
@password = correct-horse-battery
# Before each request using {{mfaCode}}, put the code shown by the authenticator app here:
@mfaCode = 000000

### Create the user of this run -> 201
# @name register
POST {{baseUrl}}/users/register HTTP/1.1
Content-Type: application/json

{
  "username": "mfa_{{$timestamp}}",
  "displayName": "MFA User",
  "password": "{{password}}"
}

### Login, MFA still off -> 200 { user }
POST {{baseUrl}}/auth/login HTTP/1.1
Content-Type: application/json

{
  "username": "{{register.response.body.user.username}}",
  "password": "{{password}}"
}

# ============================ Setup and enable ==============================

### Setup with a wrong password -> 400 INVALID_CURRENT_PASSWORD, counts as an MFA failure
POST {{baseUrl}}/auth/mfa/setup HTTP/1.1
Content-Type: application/json

{
  "password": "wrong-password"
}

### Setup -> 200 { secret, otpauthUrl, qrCodeDataUrl }, Cache-Control: no-store
# Paste qrCodeDataUrl in a browser tab and scan it, or type the secret in the authenticator app.
# Each setup replaces the previous secret: only the last QR code works
POST {{baseUrl}}/auth/mfa/setup HTTP/1.1
Content-Type: application/json

{
  "password": "{{password}}"
}

### Enable with a malformed code -> 400 VALIDATION_ERROR (6 digits expected)
POST {{baseUrl}}/auth/mfa/enable HTTP/1.1
Content-Type: application/json

{
  "code": "12ab56"
}

### Enable with a wrong code -> 400 INVALID_MFA_CODE
POST {{baseUrl}}/auth/mfa/enable HTTP/1.1
Content-Type: application/json

{
  "code": "000000"
}

### Enable with the app code (set @mfaCode first) -> 204, MFA is now on
POST {{baseUrl}}/auth/mfa/enable HTTP/1.1
Content-Type: application/json

{
  "code": "{{mfaCode}}"
}

### Enable again -> 409 MFA_ALREADY_ENABLED
POST {{baseUrl}}/auth/mfa/enable HTTP/1.1
Content-Type: application/json

{
  "code": "{{mfaCode}}"
}

### Setup once enabled -> 409 MFA_ALREADY_ENABLED, the secret is never sent again
POST {{baseUrl}}/auth/mfa/setup HTTP/1.1
Content-Type: application/json

{
  "password": "{{password}}"
}

# ========================= Two-step login (verify) ==========================

### Logout -> 204
POST {{baseUrl}}/auth/logout HTTP/1.1

### Login, MFA on -> 200 { mfaRequired: true }, pending session cookie (5 minutes)
POST {{baseUrl}}/auth/login HTTP/1.1
Content-Type: application/json

{
  "username": "{{register.response.body.user.username}}",
  "password": "{{password}}"
}

### Current user with a pending session -> 401 UNAUTHENTICATED, no access before the code
GET {{baseUrl}}/auth/session HTTP/1.1

### Setup with a pending session -> 401 UNAUTHENTICATED
POST {{baseUrl}}/auth/mfa/setup HTTP/1.1
Content-Type: application/json

{
  "password": "{{password}}"
}

### Verify with a wrong code -> 400 INVALID_MFA_CODE, the pending session stays usable
POST {{baseUrl}}/auth/mfa/verify HTTP/1.1
Content-Type: application/json

{
  "code": "000000"
}

### Verify with the code already used by enable, within 90 s -> 400 INVALID_MFA_CODE (replay)
# Leave @mfaCode unchanged for this one
POST {{baseUrl}}/auth/mfa/verify HTTP/1.1
Content-Type: application/json

{
  "code": "{{mfaCode}}"
}

### Verify with a fresh app code (update @mfaCode) -> 200 { user }, new Set-Cookie (session rotated)
POST {{baseUrl}}/auth/mfa/verify HTTP/1.1
Content-Type: application/json

{
  "code": "{{mfaCode}}"
}

### Current user after verify -> 200 { user }
GET {{baseUrl}}/auth/session HTTP/1.1

### Verify with a full session -> 401 UNAUTHENTICATED, no MFA verification pending
POST {{baseUrl}}/auth/mfa/verify HTTP/1.1
Content-Type: application/json

{
  "code": "{{mfaCode}}"
}

### Verify without any session -> 401 UNAUTHENTICATED
# Without no-cookie-jar, REST Client sends the jar session cookie FIRST and this fake one after it,
# and the server reads the first colladoc_session (the real one) -> 200 instead of 401
# @no-cookie-jar
POST {{baseUrl}}/auth/mfa/verify HTTP/1.1
Content-Type: application/json
Cookie: colladoc_session=unknown-token

{
  "code": "000000"
}

# ================================== Lock ====================================
# Logout, login again, then send "Verify with a wrong code" 5 times -> 400 x5 (the 5th one sets
# mfaLockedUntil), then any verify -> 429 TOO_MANY_ATTEMPTS, even with the right code.
# Expire the lock instead of waiting 15 minutes:
#   UPDATE "User" SET "mfaLockedUntil" = now() - interval '1 second'
#   WHERE "id" = (SELECT max("id") FROM "User" WHERE "username" LIKE 'mfa\_%');
