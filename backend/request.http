@baseUrl = http://localhost:3000

# ============================== /users/register ==============================

### Valid registration -> 201, username normalized to "newuser_01"
# Change the username suffix to replay it: once created, it returns 409
POST {{baseUrl}}/users/register HTTP/1.1
Content-Type: application/json

{
  "username": "  NewUser_01 ",
  "displayName": "New User",
  "password": "correct-horse-battery"
}

### Same registration replayed -> 409 USERNAME_TAKEN, "newuser_01" already exists
POST {{baseUrl}}/users/register HTTP/1.1
Content-Type: application/json

{
  "username": "  NewUser_01 ",
  "displayName": "New User",
  "password": "correct-horse-battery"
}

### Role injection attempt -> 400, unrecognized key
POST {{baseUrl}}/users/register HTTP/1.1
Content-Type: application/json

{
  "username": "mallory",
  "displayName": "Mallory",
  "password": "correct-horse-battery",
  "role": "ADMIN"
}

### Invalid input -> 400 VALIDATION_ERROR on username and displayName (password length is checked by the service)
POST {{baseUrl}}/users/register HTTP/1.1
Content-Type: application/json

{
  "username": "a!",
  "password": "short"
}

### Password too short -> 400 PASSWORD_TOO_SHORT (min 12 characters)
POST {{baseUrl}}/users/register HTTP/1.1
Content-Type: application/json

{
  "username": "shortpwd_user",
  "displayName": "Short Password",
  "password": "short"
}

### Password too long -> 400 PASSWORD_TOO_LONG (81 characters, max 80)
POST {{baseUrl}}/users/register HTTP/1.1
Content-Type: application/json

{
  "username": "longpwd_user",
  "displayName": "Long Password",
  "password": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
}

### Display name too short -> 400 VALIDATION_ERROR on displayName (min 2 characters)
POST {{baseUrl}}/users/register HTTP/1.1
Content-Type: application/json

{
  "username": "tiny_name",
  "displayName": "N",
  "password": "correct-horse-battery"
}

### Username taken AND password too short -> 400 PASSWORD_TOO_SHORT, not 409
# The password policy runs before the database lookup in createAccount
POST {{baseUrl}}/users/register HTTP/1.1
Content-Type: application/json

{
  "username": "  NewUser_01 ",
  "displayName": "New User",
  "password": "short"
}

### Missing body -> 400
POST {{baseUrl}}/users/register HTTP/1.1

### Malformed JSON -> 400, rejected by express.json() before reaching the controller
POST {{baseUrl}}/users/register HTTP/1.1
Content-Type: application/json

{
  "username": "bob",
  "displayName":
}

# ================================ /auth/login ================================

### Login -> 200 { user } + Set-Cookie colladoc_session (HttpOnly, SameSite=Lax, Path=/)
# Username is normalized like at registration: "  NewUser_01 " logs into "newuser_01"
POST {{baseUrl}}/auth/login HTTP/1.1
Content-Type: application/json

{
  "username": "  NewUser_01 ",
  "password": "correct-horse-battery"
}

### Wrong password -> 401 INVALID_CREDENTIALS
POST {{baseUrl}}/auth/login HTTP/1.1
Content-Type: application/json

{
  "username": "newuser_01",
  "password": "wrong-password-123"
}

### Unknown username -> 401 INVALID_CREDENTIALS, same body as a wrong password
POST {{baseUrl}}/auth/login HTTP/1.1
Content-Type: application/json

{
  "username": "nobody_here",
  "password": "wrong-password-123"
}

### Blocked account + right password -> 403 ACCOUNT_BLOCKED
# Block it first: update "User" set "blockedAt" = now() where username = 'newuser_02';
# Unblock afterwards: update "User" set "blockedAt" = null where username = 'newuser_02';
POST {{baseUrl}}/auth/login HTTP/1.1
Content-Type: application/json

{
  "username": "newuser_02",
  "password": "correct-horse-battery"
}

### Blocked account + wrong password -> 401 INVALID_CREDENTIALS, the block is not revealed
POST {{baseUrl}}/auth/login HTTP/1.1
Content-Type: application/json

{
  "username": "newuser_02",
  "password": "wrong-password-123"
}

### Unknown key -> 400 VALIDATION_ERROR
POST {{baseUrl}}/auth/login HTTP/1.1
Content-Type: application/json

{
  "username": "newuser_01",
  "password": "correct-horse-battery",
  "role": "ADMIN"
}

### Empty password -> 400 VALIDATION_ERROR on password
POST {{baseUrl}}/auth/login HTTP/1.1
Content-Type: application/json

{
  "username": "newuser_01",
  "password": ""
}

### Rate limit -> run this 6 times: 401 x5, then 429 TOO_MANY_ATTEMPTS with Retry-After: 900
# The counter lives in memory: restart the backend to reset it
POST {{baseUrl}}/auth/login HTTP/1.1
Content-Type: application/json

{
  "username": "newuser_01",
  "password": "wrong-password-for-rate-limit"
}

# ============================== /auth/session ==============================

### Current user -> 200 { user } after a successful login (the client keeps the cookie), 401 otherwise
GET {{baseUrl}}/auth/session HTTP/1.1

### Unknown session token -> 401 UNAUTHENTICATED, cookie cleared
GET {{baseUrl}}/auth/session HTTP/1.1
Cookie: colladoc_session=unknown-token

# ============================== /auth/logout ==============================

### Logout -> 204, session deleted and cookie cleared; /auth/session then returns 401
POST {{baseUrl}}/auth/logout HTTP/1.1
