### Valid registration -> 201, username normalized to "newuser_01"
# Change the username suffix to replay it: once created, it returns 409
POST http://localhost:3000/users/register HTTP/1.1
Content-Type: application/json

{
  "username": "  NewUser_01 ",
  "displayName": "New User",
  "password": "correct-horse-battery"
}

### Same registration replayed -> 409 USERNAME_TAKEN, "newuser_01" already exists
POST http://localhost:3000/users/register HTTP/1.1
Content-Type: application/json

{
  "username": "  NewUser_01 ",
  "displayName": "New User",
  "password": "correct-horse-battery"
}

### Role injection attempt -> 400, unrecognized key
POST http://localhost:3000/users/register HTTP/1.1
Content-Type: application/json

{
  "username": "mallory",
  "displayName": "Mallory",
  "password": "correct-horse-battery",
  "role": "ADMIN"
}

### Invalid input -> 400 VALIDATION_ERROR on username and displayName (password length is checked by the service)
POST http://localhost:3000/users/register HTTP/1.1
Content-Type: application/json

{
  "username": "a!",
  "password": "short"
}

### Password too short -> 400 PASSWORD_TOO_SHORT (min 12 characters)
POST http://localhost:3000/users/register HTTP/1.1
Content-Type: application/json

{
  "username": "shortpwd_user",
  "displayName": "Short Password",
  "password": "short"
}

### Password too long -> 400 PASSWORD_TOO_LONG (81 characters, max 80)
POST http://localhost:3000/users/register HTTP/1.1
Content-Type: application/json

{
  "username": "longpwd_user",
  "displayName": "Long Password",
  "password": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
}

### Display name too short -> 400 VALIDATION_ERROR on displayName (min 2 characters)
POST http://localhost:3000/users/register HTTP/1.1
Content-Type: application/json

{
  "username": "tiny_name",
  "displayName": "N",
  "password": "correct-horse-battery"
}

### Username taken AND password too short -> 400 PASSWORD_TOO_SHORT, not 409
# The password policy runs before the database lookup in createAccount
POST http://localhost:3000/users/register HTTP/1.1
Content-Type: application/json

{
  "username": "  NewUser_01 ",
  "displayName": "New User",
  "password": "short"
}

### Missing body -> 400
POST http://localhost:3000/users/register HTTP/1.1

### Malformed JSON -> 400, rejected by express.json() before reaching the controller
POST http://localhost:3000/users/register HTTP/1.1
Content-Type: application/json

{
  "username": "bob",
  "displayName":
}

### Get a profile -> 200 (dev auth stub: user taken from X-Dev-User-Id)
GET http://localhost:3000/profile/1 HTTP/1.1
X-Dev-User-Id: 1

### Unknown profile id -> 404 USER_NOT_FOUND
GET http://localhost:3000/profile/999999 HTTP/1.1
X-Dev-User-Id: 1

### Non-numeric profile id -> 400 VALIDATION_ERROR
GET http://localhost:3000/profile/abc HTTP/1.1
X-Dev-User-Id: 1

### Missing auth header -> 401 UNAUTHENTICATED
GET http://localhost:3000/profile/1 HTTP/1.1

### Update own display name -> 200
PATCH http://localhost:3000/profile HTTP/1.1
Content-Type: application/json
X-Dev-User-Id: 1

{
  "displayName": "Renamed User"
}

### Invalid display name -> 400 VALIDATION_ERROR on displayName
PATCH http://localhost:3000/profile HTTP/1.1
Content-Type: application/json
X-Dev-User-Id: 1

{
  "displayName": "<script>"
}

### Change password -> 204, other sessions are revoked
PATCH http://localhost:3000/profile/password HTTP/1.1
Content-Type: application/json
X-Dev-User-Id: 1
X-Dev-Session-Id: 1

{
  "currentPassword": "correct-horse-battery",
  "newPassword": "another-horse-battery"
}

### Wrong current password -> 400 INVALID_CURRENT_PASSWORD
PATCH http://localhost:3000/profile/password HTTP/1.1
Content-Type: application/json
X-Dev-User-Id: 1

{
  "currentPassword": "not-my-password",
  "newPassword": "another-horse-battery"
}

### Unchanged password -> 400 PASSWORD_UNCHANGED
PATCH http://localhost:3000/profile/password HTTP/1.1
Content-Type: application/json
X-Dev-User-Id: 1

{
  "currentPassword": "correct-horse-battery",
  "newPassword": "correct-horse-battery"
}

### ===== Admin =====
# Requires an authenticated admin session (res.locals.user set by the auth middleware)

### List users -> 200 { users, page, pageSize, total }
GET http://localhost:3000/admin/users?page=1&pageSize=20 HTTP/1.1

### Search users -> 200, case-insensitive match on username and displayName
GET http://localhost:3000/admin/users?search=alice HTTP/1.1

### Page size above max -> 400 VALIDATION_ERROR (max 100)
GET http://localhost:3000/admin/users?pageSize=500 HTTP/1.1

### Create a user -> 201 { user, temporaryPassword }, displayName = "new_member", mustChangePassword = true
POST http://localhost:3000/admin/users HTTP/1.1
Content-Type: application/json

{
  "username": "  New_Member ",
  "role": "USER"
}

### Create an admin -> 201
POST http://localhost:3000/admin/users HTTP/1.1
Content-Type: application/json

{
  "username": "new_admin",
  "role": "ADMIN"
}

### Create with displayName or password -> 400, unrecognized key (both are set by the server)
POST http://localhost:3000/admin/users HTTP/1.1
Content-Type: application/json

{
  "username": "someone",
  "displayName": "Someone",
  "password": "correct-horse-battery"
}

### Block a user -> 200, blockedAt and blockedBy set, sessions deleted
# Replay -> 200, unchanged (original blockedAt kept)
POST http://localhost:3000/admin/users/2/block HTTP/1.1

### Unblock a user -> 200, blockedAt and blockedBy back to null
POST http://localhost:3000/admin/users/2/unblock HTTP/1.1

### Block own account -> 403 CANNOT_BLOCK_SELF (replace 1 with the current admin id)
POST http://localhost:3000/admin/users/1/block HTTP/1.1

### Unknown user -> 404 USER_NOT_FOUND
POST http://localhost:3000/admin/users/999999/block HTTP/1.1

### Non-numeric id -> 400 VALIDATION_ERROR
POST http://localhost:3000/admin/users/abc/block HTTP/1.1
