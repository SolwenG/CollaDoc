// use prisma-8

// Modèle de données CollaDoc — voir doc/doc.md (section 5).

enum Role {
  @@type("pg/text@1")
  USER  = "USER"
  ADMIN = "ADMIN"
}

enum DocumentKind {
  @@type("pg/text@1")
  TEXT = "TEXT"
  FILE = "FILE"
}

enum MemberRole {
  @@type("pg/text@1")
  EDITOR = "EDITOR"
  VIEWER = "VIEWER"
}

model User {
  id                 Int                @id @default(autoincrement())
  username           String             @unique // identifiant de connexion, non modifiable
  displayName        String // nom affiché dans l'app et les docs partagés
  passwordHash       String // argon2
  role               Role               @default(USER)
  mustChangePassword Boolean            @default(false) // true pour un compte créé par un admin
  totpSecret         String? // chiffré en AES-GCM (clé dans .env)
  totpEnabledAt      TimestamptzString? // null = MFA désactivé
  totpLastUsedStep   Int? // dernier pas TOTP de 30 s accepté : un code de ce pas ou d'avant est un rejeu
  mfaFailedAttempts  Int                @default(0) // échecs MFA consécutifs (mot de passe du setup ou code)
  mfaLockedUntil     TimestamptzString? // dans le futur = tentatives MFA refusées jusque-là
  blockedAt          TimestamptzString? // non null = connexion impossible
  blockedById        Int?
  blockedBy          User?              @relation("UserBlockedBy", fields: [blockedById], references: [id])
  createdById        Int? // null = inscription libre
  createdBy          User?              @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdAt          TimestamptzString  @default(now())
  updatedAt          temporal.updatedAtString()
}

model Session {
  id           Int               @id @default(autoincrement())
  tokenHash    String            @unique // SHA-256 du token du cookie
  userId       Int
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  mfaSatisfied Boolean // false = 2FA activé et TOTP toujours en attente; true = rien d'autre a vérifier (pas de 2FA activé ou code TOTP donné/rempli)
  expiresAt    TimestamptzString // 5 min si le TOTP est attendu, 7 jours glissants sinon
  createdAt    TimestamptzString @default(now())
  lastUsedAt   TimestamptzString @default(now())

  @@index([userId])
}

model Folder {
  id        Int               @id @default(autoincrement())
  name      String
  parentId  Int? // null = racine
  parent    Folder?           @relation(fields: [parentId], references: [id], onDelete: Cascade)
  ownerId   Int
  owner     User              @relation(fields: [ownerId], references: [id])
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@unique([ownerId, parentId, name])
  @@index([ownerId, name], where: "\"parentId\" IS NULL", unique: true, name: "Folder_root_name_unique")
}

model Document {
  id               Int               @id @default(autoincrement())
  name             String
  kind             DocumentKind
  ownerId          Int
  owner            User              @relation("DocumentOwner", fields: [ownerId], references: [id])
  folderId         Int? // null = racine du propriétaire
  folder           Folder?           @relation(fields: [folderId], references: [id], onDelete: Cascade)
  // TEXT
  content          String? // Instantané du texte brut
  contentRevision  Int               @default(0) // Révision à laquelle correspond content
  // FILE
  originalName     String?
  storagePath      String? // nom snapshotRevisionUUID sur le disque
  mimeType         String?
  size             Int?
  // commun
  lastModifiedById Int?
  lastModifiedBy   User?             @relation("DocumentLastModifiedBy", fields: [lastModifiedById], references: [id])
  createdAt        TimestamptzString @default(now())
  updatedAt        temporal.updatedAtString()

  @@index([ownerId, folderId])
}

model DocumentMember {
  documentId  Int
  document    Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId      Int
  user        User              @relation("DocumentMemberUser", fields: [userId], references: [id])
  role        MemberRole
  invitedById Int
  invitedBy   User              @relation("DocumentMemberInvitedBy", fields: [invitedById], references: [id])
  createdAt   TimestamptzString @default(now())

  @@id([documentId, userId])
  @@index([userId])
}

model ShareLink {
  id          Int                @id @default(autoincrement())
  tokenHash   String             @unique // SHA-256 du jeton du lien, comme Session
  documentId  Int
  document    Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  role        MemberRole // rôle donné à qui accepte le lien
  createdById Int // devient invitedById du membre ajouté
  createdBy   User               @relation(fields: [createdById], references: [id])
  expiresAt   TimestamptzString // createdAt + 7 jours
  revokedAt   TimestamptzString? // non null = lien révoqué par le propriétaire
  createdAt   TimestamptzString  @default(now())

  @@index([documentId])
}

model DocumentOperation {
  id         Int               @id @default(autoincrement())
  documentId Int
  document   Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  revision   Int
  opId       String            @unique // UUID généré par le client, détecte les renvois après coupure
  operation  Json // Step[] : voir shared/ot/operation.ts
  authorId   Int
  author     User              @relation(fields: [authorId], references: [id])
  createdAt  TimestamptzString @default(now())

  @@unique([documentId, revision])
}

model Message {
  id         Int               @id @default(autoincrement())
  documentId Int
  document   Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  authorId   Int
  author     User              @relation(fields: [authorId], references: [id])
  content    String
  createdAt  TimestamptzString @default(now())

  @@index([documentId, createdAt])
}
