{
    "$schema": "https://json.schemastore.org/prettierrc",
    "trailingComma": "es5",
    "tabWidth": 4,
    "semi": false,
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
        {
            "files": ["*.yaml", "*.yml"],
            "options": { "tabWidth": 2 }
        }
    ]
}
