POSTGRES_USER=colladoc
POSTGRES_PASSWORD=colladoc
POSTGRES_DB=colladoc

DB_PORT="5433"
BACKEND_PORT="3000"
FRONTEND_PORT="8080"
REALTIME_PORT="3001"

# Shared by the API and realtime servers.
# Generate one with: openssl rand -hex 32
INTERNAL_SECRET=change-me

# Key encrypting TOTP secrets at rest (AES-256-GCM): 32 random bytes, base64.
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY="replace-with-a-generated-key"

# Key signing the share links (HMAC-SHA256): 32 random bytes, base64.
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
SHARE_LINK_SECRET="replace-with-a-generated-key"
